# ---- Ma'lumotlar bazasi ----
# Vercel Postgres / Neon / o'zingizning Postgres (POSTGRES_URL ham qabul qilinadi).
# Bo'sh qolsa — lokal kompyuterda PGlite (.data/pglite). Vercel'da baza ULANISHI SHART, aks holda login o'chadi.
DATABASE_URL=

# ---- Supabase (production; Vercel integratsiyasi SB_ prefiksi bilan o'zi qo'shadi) ----
# Baza (DATABASE_URL'dan ustun) va real-time signallar. Bo'sh bo'lsa — DATABASE_URL yoki PGlite, real-time o'rniga 30 s tekshiruv.
SB_POSTGRES_URL=
SB_POSTGRES_URL_NON_POOLING=
NEXT_PUBLIC_SB_SUPABASE_URL=
NEXT_PUBLIC_SB_SUPABASE_ANON_KEY=

# Saytning to'liq manzili (Telegram xabarlaridagi havolalar uchun)
APP_URL=http://localhost:3000

# ---- Telegram bot ----
# @BotFather'dan olingan token
TELEGRAM_BOT_TOKEN=
# Bot username (@ belgisisiz), masalan: ScorelySatBot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Webhook so'rovlarini tekshirish uchun tasodifiy uzun satr (faqat A-Z, a-z, 0-9, _ va -)
TELEGRAM_WEBHOOK_SECRET=

# ---- Cron ----
# Vercel Cron so'rovlarini tekshirish uchun tasodifiy uzun satr
CRON_SECRET=
